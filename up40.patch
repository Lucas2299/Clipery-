+  });
+
+  /* ---------- 3. render ---------- */
+  if (renderBtn) renderBtn.addEventListener("click", async function () {
+    if (!plan.length) return;
+    renderBtn.disabled = true; setMsg(renderMsg, "");
+    try {
+      var body = { jobId: jobId, clips: plan.map(function (p) {
