+  }
+
+  function findPlan(id) { for (var i = 0; i < plan.length; i++) if (plan[i].id === id) return plan[i]; return null; }
+
+  if (list) {
+    list.addEventListener("click", function (ev) {
+      var cardEl = ev.target.closest ? ev.target.closest(".ed-card") : null;
+      if (!cardEl) return;
