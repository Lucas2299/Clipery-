+        padding: 2.5rem 1.1rem 4rem;
+      }
+      .auth-card {
+        width: 100%;
+        max-width: 430px;
+        background: rgba(14, 14, 20, 0.92);
+        border: 1px solid rgba(255, 255, 255, 0.09);
+        border-radius: 20px;
