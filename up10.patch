+        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
+      }
+      .auth-card h1 { font-size: 1.55rem; margin: 0 0 0.35rem; }
+      .auth-sub { color: #9894a6; font-size: 0.92rem; margin: 0 0 1.4rem; }
+      .auth-tabs { display: flex; gap: 0.5rem; margin: 0 0 1.35rem; }
+      .auth-tab {
+        flex: 1; padding: 0.6rem 0.5rem; border-radius: 999px; cursor: pointer;
+        font-family: inherit; font-weight: 700; font-size: 0.9rem;
+        border: 1px solid rgba(255, 255, 255, 0.16); background: transparent; color: #f4f1ea;
+        transition: all 0.15s;
+      }
+      .auth-tab.on {
+        background: linear-gradient(135deg, #ff4d6d, #ff8a4c);
+        border-color: transparent; color: #fff;
+        box-shadow: 0 8px 22px rgba(255, 77, 109, 0.32);
+      }
+      .auth-field { margin: 0 0 0.95rem; }
+      .auth-field label {
+        display: block; font-size: 0.82rem; font-weight: 700;
+        color: #c9c5d8; margin: 0 0 0.35rem;
+      }
+      .auth-field input {
+        width: 100%; padding: 0.78rem 0.9rem; border-radius: 12px;
+        border: 1px solid rgba(255, 255, 255, 0.14); background: rgba(0, 0, 0, 0.4);
+        color: #f4f1ea; font-family: inherit; font-size: 0.95rem;
+      }
+      .auth-field input:focus { outline: none; border-color: #ff4d6d; }
+      .auth-hint { font-size: 0.76rem; color: #66627a; margin: 0.35rem 0 0; }
+      .auth-submit { width: 100%; margin-top: 0.4rem; justify-content: center; }
+      .auth-msg {
+        display: none; margin: 0 0 1rem; padding: 0.7rem 0.85rem; border-radius: 12px;
+        font-size: 0.87rem; line-height: 1.45;
+      }
