diff --git a/clipery/public/logo.svg b/clipery/public/logo.svg
new file mode 100644
index 0000000..5e793c7
--- /dev/null
+++ b/clipery/public/logo.svg
@@ -0,0 +1,61 @@
+<svg xmlns="http://www.w3.org/2000/svg" width="245" height="64" viewBox="0 0 245 64" role="img" aria-label="Clipery">
+  <defs>
+    <linearGradient id="ring" x1="0" y1="0" x2="0.9" y2="1">
+      <stop offset="0" stop-color="#FFB03A"/>
+      <stop offset="0.45" stop-color="#FF7A52"/>
+      <stop offset="1" stop-color="#F02E8A"/>
+    </linearGradient>
+    <linearGradient id="word" x1="0" y1="0" x2="1" y2="0">
+      <stop offset="0" stop-color="#FFB03A"/>
+      <stop offset="0.35" stop-color="#FF8A4E"/>
+      <stop offset="0.68" stop-color="#FF5A63"/>
+      <stop offset="1" stop-color="#F02E8A"/>
+    </linearGradient>
+    <linearGradient id="play" x1="0" y1="0" x2="0" y2="1">
+      <stop offset="0" stop-color="#FFE0BA"/>
+      <stop offset="1" stop-color="#FF9E5C"/>
+    </linearGradient>
+  </defs>
+
+  <!-- circuit traces on the left -->
+  <g stroke="#C73568" stroke-width="2" fill="none" stroke-linecap="round">
+    <path d="M4 18 h7 l3 3 h6"/>
+    <path d="M3 26 h10 l4 4 h4"/>
+    <path d="M4 33 h14"/>
+    <path d="M3 40 h9 l3 -3 h5"/>
+    <path d="M5 47 h6 l4 -4 h5"/>
+  </g>
+  <g fill="#E0487C">
+    <circle cx="4" cy="18" r="2.2"/>
+    <circle cx="3" cy="26" r="2.2"/>
+    <circle cx="4" cy="33" r="2.2"/>
+    <circle cx="3" cy="40" r="2.2"/>
+    <circle cx="5" cy="47" r="2.2"/>
+  </g>
+
+  <!-- dark disc inside the C -->
+  <circle cx="26" cy="32" r="14.5" fill="#31102B" opacity="0.92"/>
+
+  <!-- traces printed on the disc -->
+  <g stroke="#8E2450" stroke-width="1.6" fill="none" stroke-linecap="round">
+    <path d="M20 21 l6 5"/>
+    <path d="M21 30 l5 2"/>
+    <path d="M16 33 h6"/>
+    <path d="M19 43 l5 -4"/>
+  </g>
+  <g fill="#D13A6B">
+    <circle cx="20" cy="21" r="1.5"/>
+    <circle cx="21" cy="30" r="1.5"/>
+    <circle cx="16" cy="33" r="1.5"/>
+    <circle cx="19" cy="43" r="1.5"/>
+  </g>
+
+  <!-- the big C ring -->
+  <path d="M 49.2 44 A 21 21 0 1 1 49.2 20" fill="none" stroke="url(#ring)" stroke-width="8" stroke-linecap="round"/>
+
+  <!-- play button -->
+  <path d="M27 24 L27 40 L41 32 Z" fill="url(#play)" stroke="#FFE8D0" stroke-width="1" stroke-linejoin="round"/>
+
+  <!-- wordmark -->
+  <text x="68" y="43" font-family="'Arial Black','Helvetica Neue',Arial,'DejaVu Sans',sans-serif" font-weight="900" font-size="30" letter-spacing="1.5" fill="url(#word)">CLIPERY</text>
+</svg>
