+      // Mark the plan the logged-in account is on.
+      fetch("/api/auth/me").then(function (r) { return r.json(); }).then(function (d) {
+        if (!d || !d.user) return;
+        var plan = d.user.plan || "free";
+        var map = { free: "free", plus: "pro", pro: "pro", unlimited: "unlimited" };
+        var card = document.querySelector('.price-card[data-plan="' + (map[plan] || "free") + '"]');
+        if (card) {
+          card.classList.add("current");
+          var a = card.querySelector("a.btn");
+          if (a) { a.textContent = "Your current plan"; a.setAttribute("href", "/account"); a.classList.remove("btn-primary"); a.classList.add("btn-ghost"); }
+        }
+        var note = document.getElementById("plan-current");
+        if (note) {
+          var left = d.user.videosTotal == null ? "unlimited videos" : (d.user.videosLeft == null ? 0 : d.user.videosLeft) + " of " + d.user.videosTotal + " videos left this month";
+          note.textContent = "You are on the " + (d.user.planLabel || "Free") + " plan - " + left + ".";
+          note.hidden = false;
+        }
+      }).catch(function () {});
+    </script>
