# Copy to ".env" and fill in — the server loads it automatically on start.
# Any provider you leave blank stays hidden on the login page.

# Google — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple — https://developer.apple.com/account/resources/identifiers
# Return URL: https://YOUR-DOMAIN/api/auth/apple/callback  (HTTPS only)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=

# Only needed behind a proxy/CDN
BASE_URL=

# ---------------------------------------------------------------------------
# Hosting. Ignore all of this while you run on localhost.
# ---------------------------------------------------------------------------

# Owner accounts for the dashboard (comma separated). Without this the FIRST
# account that ever registered is the owner.
ADMIN_EMAILS=

# Housekeeping. Clips are deleted after this many days - set 0 to keep forever.
CLIPERY_RETENTION_DAYS=30
# How often the cleanup runs, in hours.
CLIPERY_CLEANUP_HOURS=6
# Source uploads are only needed while rendering; delete them after N hours.
CLIPERY_UPLOAD_HOURS=24
# How many videos may wait in line before new uploads are turned away.
CLIPERY_MAX_QUEUE=20

# Speech model: tiny (fastest) | base (default) | small (most accurate)
CLIPERY_WHISPER_MODEL=base

# One switch for an old or low-power PC: tiny speech model + fastest encoder.
# Roughly 3x quicker than the defaults, slightly rougher captions and files.
# CLIPERY_FAST=1

# Speech decoding beam. 1 = greedy and about twice as fast (default),
# 5 = the most accurate setting.
# CLIPERY_WHISPER_BEAM=1

# CPU cores the speech model may use. Defaults to every core you have.
# CLIPERY_WHISPER_THREADS=4

# x264 encoder speed / quality. Lower CRF = better quality, bigger file.
# CLIPERY_PRESET=veryfast
# CLIPERY_CRF=24

# Brain 3 editor moves (all on by default). Set to 0 to switch one off.
# CLIPERY_PUNCH_IN=0    no gentle zoom on the key line
# CLIPERY_TRIM=0        keep long pauses inside clips instead of cutting them
# CLIPERY_EMPHASIS=0    plain captions, no bold key words
